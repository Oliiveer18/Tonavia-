  { "_": "Opciones de una encrucijada. mod = modificador que se recibe; cofre = rareza del premio.", "id": "pacto", "texto": "Una voz ofrece un trato: carga con una maldición y llévate un tesoro.", "opciones": [ { "txt": "Aceptar el trato", "sub": "Maldición + cofre épico", "mod": "maldicion", "cofre": "epica" }, { "txt": "Seguir de largo", "sub": "No pasa nada" } ] },
