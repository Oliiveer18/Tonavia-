 },
 "leyenda": {
  "_": "Letras de las salas prefabricadas. Una sala puede cambiar o añadir letras con su propia «leyenda». canal = cable lógico que une fuentes (placa, botón, palanca) con puertas.",
  "#": { "t": "roca" }, ".": { "t": "suelo" }, "E": { "t": "entrada" }, "S": { "t": "salida" },
  ":": { "t": "foso" }, "i": { "t": "hielo" }, "o": { "t": "bloque" },
  "a": { "t": "placa", "canal": "a" }, "b": { "t": "placa", "canal": "b" }, "c": { "t": "placa", "canal": "c" }, "d": { "t": "placa", "canal": "d" },
  "A": { "t": "puerta", "canal": "a" }, "B": { "t": "puerta", "canal": "b" }, "C": { "t": "puerta", "canal": "c" }, "D": { "t": "puerta", "canal": "d" },
  "X": { "t": "puerta", "canal": "a", "inv": true }, "Y": { "t": "puerta", "canal": "b", "inv": true },
  "H": { "t": "puerta", "canal": "a", "estilo": "puente" }, "I": { "t": "puerta", "canal": "b", "estilo": "puente" },
  "1": { "t": "palanca", "canal": "a" }, "2": { "t": "palanca", "canal": "b" }, "3": { "t": "palanca", "canal": "c" }, "4": { "t": "palanca", "canal": "d" },
  "u": { "t": "boton", "canal": "a" }, "v": { "t": "boton", "canal": "b" },
  "<": { "t": "runa", "slot": 0 }, ">": { "t": "runa", "slot": 1 },
  "p": { "t": "teleporte", "par": "pq" }, "q": { "t": "teleporte", "par": "pq" },
  "{": { "t": "subida" }, "}": { "t": "bajada" }, "@": { "t": "portal" }, "!": { "t": "estela" },
  "$": { "t": "cofre" }, "*": { "t": "jefe" }, "J": { "t": "puerta", "canal": "jefe" }, "K": { "t": "cerradura" },
  "+": { "t": "altar" }, "&": { "t": "hoguera" }, "%": { "t": "mercader" }, "?": { "t": "evento" }
 },
